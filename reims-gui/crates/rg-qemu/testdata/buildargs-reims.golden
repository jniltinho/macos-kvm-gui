-name
macOS
-enable-kvm
-m
8192
-cpu
Skylake-Client,-hle,-rtm,kvm=on,vendor=GenuineIntel,+invtsc,vmware-cpuid-freq=on,+ssse3,+sse4.2,+popcnt,+avx,+aes,+xsave,+xsaveopt,check
-machine
q35,memory-backend=ram
-object
memory-backend-memfd,id=ram,size=8192M,share=on
-global
ICH9-LPC.disable_s3=1
-vga
none
-device
qemu-xhci,id=xhci,conditional-intr-mapping=on
-device
usb-kbd,bus=xhci.0
-device
usb-tablet,bus=xhci.0
-smp
8,sockets=1,cores=4,threads=2
-device
usb-ehci,id=ehci
-device
isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc
-drive
if=pflash,format=raw,readonly=on,file=/vm/a,,b/macos-kvm-gui/OVMF_CODE_4M.fd
-drive
if=pflash,format=raw,file=/vm/a,,b/macos-kvm-gui/OVMF_VARS_4M.fd
-smbios
type=2
-device
ich9-intel-hda
-device
hda-duplex,audiodev=snd0
-audiodev
pipewire,id=snd0
-device
usb-audio,audiodev=snd0,bus=xhci.0
-device
ich9-ahci,id=sata
-drive
id=OpenCoreBoot,if=none,format=raw,readonly=on,file=fat:/vm/a,,b/macos-kvm-gui/efi
-device
virtio-blk-pci,drive=OpenCoreBoot,bootindex=0
-device
ide-hd,bus=sata.3,drive=InstallMedia
-drive
id=InstallMedia,if=none,format=raw,file=/vm/a,,b/BaseSystem.img
-drive
id=MacHDD,if=none,format=qcow2,file=/vm/a,,b/mac_hdd_ng.img
-device
ide-hd,bus=sata.4,drive=MacHDD
-netdev
user,id=net0,hostfwd=tcp:127.0.0.1:2222-:22
-device
virtio-net-pci,netdev=net0,id=net0,mac=52:54:00:c9:18:27
-device
apple-gfx-pci,id=gfx,displays=1,resolution=1920x1080
-display
none
-vnc
unix:/run/macos-kvm-gui-x/vnc.sock,lock-key-sync=off
-qmp
unix:/run/macos-kvm-gui-x/qmp.sock,server=on,wait=off
-qmp
unix:/run/macos-kvm-gui-x/qmp-control.sock,server=on,wait=off
